# PayRakshak (AREA51) Backend Environment Configuration
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS

# Server Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://pay-rakshak.vercel.app

# Database Configuration (Supabase PostgreSQL via Psycopg2)
# Direct connection (Session Pooler port 5432 or Transaction Pooler port 6543)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres.gelufrsfozrfhqhoravs:YOUR_DB_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Legacy Local MySQL Configuration (Backup/Fallback)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/payrakshak

# Gemini API Integration (Never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
