# PayRakshak (AREA51) Backend Environment Configuration
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS

# Server Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (MySQL / MariaDB via PyMySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/payrakshak_db

# Gemini API Integration (Never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
